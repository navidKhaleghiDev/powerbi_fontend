{
  "name": "powerbi-control-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3001",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "stack:init": "node scripts/init-local-stack.mjs",
    "stack:up": "node scripts/local-stack.mjs up",
    "stack:status": "node scripts/local-stack.mjs status",
    "stack:logs": "node scripts/local-stack.mjs logs",
    "stack:stop": "node scripts/local-stack.mjs stop",
    "stack:provision": "node scripts/local-stack.mjs provision",
    "stack:verify": "node scripts/local-stack.mjs verify",
    "stack:exercise": "node scripts/local-stack.mjs change",
    "stack:seed": "node --import tsx scripts/provision-local-stack.ts",
    "stack:check": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "^5.2.0",
    "@tanstack/react-query": "5.102.8",
    "axios": "^1.12.0",
    "next": "16.4.3",
    "next-intl": "4.14.5",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-date-object": "2.1.9",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.59.0",
    "react-multi-date-picker": "4.5.2",
    "recharts": "3.10.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "^8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
