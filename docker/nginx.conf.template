server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/cube-management/ {
        resolver 127.0.0.11 ipv6=off;
        set $cube_management_host cube-management:3002;
        proxy_pass http://$cube_management_host;
        proxy_set_header Host $host;
        proxy_set_header X-Management-Key "${CUBE_MANAGEMENT_KEY}";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
