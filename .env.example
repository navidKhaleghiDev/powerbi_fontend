# API server URL. Leave empty to use same-origin /api requests.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional Cube deployment. Supply these only when connecting to a real instance.
VITE_CUBE_API_URL=
VITE_CUBE_TOKEN=

# Dashboard AI chat uses the application-configured OpenRouter key.
# VITE_* values are public in browser bundles; use a restricted spending limit.
# Set the actual value in the ignored .env file, never in this tracked template.
VITE_OPENROUTER_API_KEY=
 