# Copy to .env.server in the repository root, then replace these values.
CUBE_MODEL_DIR=/absolute/host/path/to/cube/model/cubes
CUBE_MANAGEMENT_KEY=
CUBE_MANAGEMENT_PORT=3002
CUBE_MANAGEMENT_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# This URL is reached by Express, not by the browser.
CUBE_SERVER_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_SERVER_TOKEN=

# Optional: local-development-only database metadata discovery.
CUBE_SCHEMA_DISCOVERY_URL=http://localhost:4000/playground/db-schema
